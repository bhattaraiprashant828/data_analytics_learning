    "class student:\n",
    "    def __init__(self,name,age):\n",
    "        self.name=name\n",
    "        self.age=age\n",
    "    def display(self):\n",
    "        print(self.name,self.age)\n",
    "s1=student(\"Ram\",3)\n",
    "s2=student(\"Harry\",10)\n",
    "\n",
    "s1.display()\n",
    "s2.display()\n",
    "\n"
   ]
  }
